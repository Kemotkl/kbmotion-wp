{
	"$schema": "https://schemas.wp.org/wp/6.5/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": { "contentSize": "780px", "wideSize": "1240px" },
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"palette": [
				{ "slug": "ink", "name": "Czerń", "color": "#0b0b0c" },
				{ "slug": "coal", "name": "Węgiel", "color": "#141416" },
				{ "slug": "graphite", "name": "Grafit", "color": "#1f1f23" },
				{ "slug": "gold", "name": "Złoto", "color": "#c8a15a" },
				{ "slug": "gold-light", "name": "Jasne złoto", "color": "#e3c98f" },
				{ "slug": "sand", "name": "Piasek", "color": "#f4efe6" },
				{ "slug": "paper", "name": "Papier", "color": "#fbf9f5" },
				{ "slug": "white", "name": "Biel", "color": "#ffffff" },
				{ "slug": "muted", "name": "Szary", "color": "#a29d94" },
				{ "slug": "text", "name": "Tekst", "color": "#17171a" }
			]
		},
		"typography": {
			"fluid": true,
			"defaultFontSizes": false,
			"fontFamilies": [
				{
					"slug": "display",
					"name": "Oswald",
					"fontFamily": "Oswald, 'Arial Narrow', Arial, sans-serif",
					"fontFace": [
						{ "fontFamily": "Oswald", "fontWeight": "200 700", "fontStyle": "normal", "fontDisplay": "swap", "src": [ "file:./assets/fonts/oswald-latin-wght-normal.woff2" ], "unicodeRange": "U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD" },
						{ "fontFamily": "Oswald", "fontWeight": "200 700", "fontStyle": "normal", "fontDisplay": "swap", "src": [ "file:./assets/fonts/oswald-latin-ext-wght-normal.woff2" ], "unicodeRange": "U+0100-02BA,U+02BD-02C5,U+02C7-02CC,U+02CE-02D7,U+02DD-02FF,U+0304,U+0308,U+0329,U+1D00-1DBF,U+1E00-1E9F,U+1EF2-1EFF,U+2020,U+20A0-20AB,U+20AD-20C0,U+2113,U+2C60-2C7F,U+A720-A7FF" }
					]
				},
				{
					"slug": "body",
					"name": "Manrope",
					"fontFamily": "Manrope, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
					"fontFace": [
						{ "fontFamily": "Manrope", "fontWeight": "200 800", "fontStyle": "normal", "fontDisplay": "swap", "src": [ "file:./assets/fonts/manrope-latin-wght-normal.woff2" ], "unicodeRange": "U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD" },
						{ "fontFamily": "Manrope", "fontWeight": "200 800", "fontStyle": "normal", "fontDisplay": "swap", "src": [ "file:./assets/fonts/manrope-latin-ext-wght-normal.woff2" ], "unicodeRange": "U+0100-02BA,U+02BD-02C5,U+02C7-02CC,U+02CE-02D7,U+02DD-02FF,U+0304,U+0308,U+0329,U+1D00-1DBF,U+1E00-1E9F,U+1EF2-1EFF,U+2020,U+20A0-20AB,U+20AD-20C0,U+2113,U+2C60-2C7F,U+A720-A7FF" }
					]
				}
			],
			"fontSizes": [
				{ "slug": "small", "name": "Mały", "size": "0.875rem", "fluid": false },
				{ "slug": "medium", "name": "Średni", "size": "1.0625rem", "fluid": false },
				{ "slug": "large", "name": "Duży", "size": "1.375rem", "fluid": { "min": "1.2rem", "max": "1.5rem" } },
				{ "slug": "x-large", "name": "Bardzo duży", "size": "2.25rem", "fluid": { "min": "1.75rem", "max": "2.75rem" } },
				{ "slug": "xx-large", "name": "Ogromny", "size": "4rem", "fluid": { "min": "2.5rem", "max": "4.5rem" } },
				{ "slug": "huge", "name": "Hero", "size": "5.5rem", "fluid": { "min": "2.9rem", "max": "6.25rem" } }
			]
		},
		"spacing": {
			"units": [ "px", "rem", "%", "vw", "vh" ],
			"spacingSizes": [
				{ "slug": "20", "name": "XS", "size": "0.5rem" },
				{ "slug": "30", "name": "S", "size": "1rem" },
				{ "slug": "40", "name": "M", "size": "clamp(1.25rem, 2.5vw, 2rem)" },
				{ "slug": "50", "name": "L", "size": "clamp(2rem, 5vw, 3.5rem)" },
				{ "slug": "60", "name": "XL", "size": "clamp(3rem, 8vw, 6rem)" },
				{ "slug": "70", "name": "XXL", "size": "clamp(4rem, 11vw, 8.5rem)" }
			]
		},
		"custom": { "radius": "18px" }
	},
	"styles": {
		"color": { "background": "var(--wp--preset--color--paper)", "text": "var(--wp--preset--color--text)" },
		"spacing": { "padding": { "left": "clamp(16px, 4vw, 40px)", "right": "clamp(16px, 4vw, 40px)" }, "blockGap": "1.25rem" },
		"typography": { "fontFamily": "var(--wp--preset--font-family--body)", "fontSize": "var(--wp--preset--font-size--medium)", "lineHeight": "1.65" },
		"elements": {
			"heading": {
				"typography": { "fontFamily": "var(--wp--preset--font-family--display)", "fontWeight": "600", "lineHeight": "1.05", "textTransform": "uppercase", "letterSpacing": "0.005em" }
			},
			"h1": { "typography": { "fontSize": "var(--wp--preset--font-size--xx-large)" } },
			"h2": { "typography": { "fontSize": "var(--wp--preset--font-size--x-large)" } },
			"h3": { "typography": { "fontSize": "var(--wp--preset--font-size--large)", "lineHeight": "1.15" } },
			"h4": { "typography": { "fontSize": "1.125rem" } },
			"link": {
				"color": { "text": "currentColor" },
				"typography": { "textDecoration": "underline" },
				":hover": { "color": { "text": "var(--wp--preset--color--gold)" } }
			},
			"button": {
				"color": { "background": "var(--wp--preset--color--gold)", "text": "#111111" },
				"border": { "radius": "999px" },
				"typography": { "fontFamily": "var(--wp--preset--font-family--body)", "fontWeight": "700", "fontSize": "0.95rem", "letterSpacing": "0.02em" },
				"spacing": { "padding": { "top": "0.95em", "bottom": "0.95em", "left": "1.6em", "right": "1.6em" } },
				":hover": { "color": { "background": "var(--wp--preset--color--gold-light)", "text": "#111111" } }
			}
		},
		"blocks": {
			"core/navigation": { "typography": { "fontSize": "0.9rem", "fontWeight": "600" } },
			"core/separator": { "color": { "text": "var(--wp--preset--color--gold)" } },
			"core/quote": { "border": { "left": { "color": "var(--wp--preset--color--gold)", "width": "3px" } } }
		}
	},
	"templateParts": [
		{ "name": "header", "title": "Nagłówek", "area": "header" },
		{ "name": "footer", "title": "Stopka", "area": "footer" }
	],
	"customTemplates": [
		{ "name": "page-landing", "title": "Strona sprzedażowa (bez tytułu)", "postTypes": [ "page" ] }
	]
}
